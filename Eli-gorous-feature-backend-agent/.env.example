# LLM provider selection
# auto: use Gemini when GEMINI_API_KEY exists, otherwise fallback to Ollama
# gemini: force Gemini
# ollama: force Ollama
LLM_PROVIDER=auto

# Gemini settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Leave empty to skip secondary Gemini fallback and go directly to Ollama on quota errors.
GEMINI_FALLBACK_MODEL=

# Ollama fallback settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
